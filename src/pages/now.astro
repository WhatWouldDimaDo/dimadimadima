---
import Layout from '../layouts/Layout.astro';

const SUNO_SONGS = [
  {
    title: 'SkiBiDub Never Stop',
    note: 'Ruby Dean’s current anthem',
    url: 'https://suno.com/song/18000716-8f78-4b7d-9b76-44935273582a',
    video: '/videos/suno/skibidub-never-stop-preview.mp4',
  },
  {
    title: 'Ra Ra Waffle Time',
    note: 'Breakfast as a rallying cry',
    url: 'https://suno.com/song/f77a9ac9-55e8-4ec7-a8e1-7b3b15b685ee',
    video: '/videos/suno/ra-ra-waffle-time-preview.mp4',
  },
  {
    title: 'Ruby, Olé!',
    note: 'A tiny family epic',
    url: 'https://suno.com/song/82d5df90-50d0-440a-bfe1-9924e0f8f734',
    image: '/videos/suno/ruby-ole.jpg',
  },
  {
    title: 'Breakin’ Out the Breakfast',
    note: 'Trap funk before coffee',
    url: 'https://suno.com/s/X0du2VgcCIulNzJG',
    image: '/videos/suno/breakin-out-the-breakfast.jpg',
  },
];
---

<Layout title="Now — Dima Perkis" description="What Dima Perkis is focused on, building, learning, and enjoying now.">
  <section class="now-hero">
    <div>
      <p class="page-eyebrow">Now · July 2026 · Atlanta</p>
      <h1 class="page-title">What has my<br />attention now</h1>
    </div>
    <div class="now-intro">
      <p>A current snapshot of the work, ideas, and people occupying most of my headspace. More useful than pretending an About page never changes.</p>
      <span>Last updated <time datetime="2026-07">July 2026</time></span>
    </div>
  </section>

  <section class="now-grid" aria-label="Current focus areas">
    <article class="now-card now-card--work">
      <span class="now-number">01</span>
      <span class="now-project-icon now-project-icon--groundline" aria-hidden="true">G</span>
      <p class="section-kicker">Work</p>
      <h2>Building an AI growth practice</h2>
      <p>I’m using <a class="inline-project inline-project--groundline" href="/projects/groundline-ai-growth"><span aria-hidden="true">G</span>Groundline</a> to explore how builders and high-end trades can uncover growth opportunities, create the lightbulb moment, and bring the first useful system to life with their team</p>
    </article>

    <article class="now-card now-card--build">
      <span class="now-number">02</span>
      <span class="now-project-icon now-project-icon--permit" aria-hidden="true">⌖</span>
      <p class="section-kicker">Building</p>
      <h2>Finding the signal before the sale</h2>
      <p><a class="inline-project inline-project--permit" href="/projects/permit-propensity"><span aria-hidden="true">⌖</span>Permit Propensity</a> is testing whether 8,701 permits, 143,031 parcels, and 97,446 valuation records can uncover better opportunities for high-end trades without pretending the data can predict more than it can</p>
    </article>

    <article class="now-card">
      <span class="now-number">03</span>
      <span class="now-project-icon" aria-hidden="true">✦</span>
      <p class="section-kicker">Practicing</p>
      <h2>Build less, talk to more people</h2>
      <p>My instinct is to keep making the system smarter. My current discipline is to narrow what exists, put it in front of landscapers and pool builders, and let real conversations decide what deserves another night of building</p>
      <a href="/contact">Talk to me about the idea →</a>
    </article>

    <article class="now-card">
      <span class="now-number">04</span>
      <span class="now-project-icon now-project-icon--radar" aria-hidden="true"><img src="/atl/favicon.svg" alt="" /></span>
      <p class="section-kicker">Using</p>
      <h2>My projects in the real world</h2>
      <p><a class="inline-project inline-project--radar" href="https://dimadimadima.com/atl" target="_blank" rel="noopener noreferrer"><img src="/atl/favicon.svg" alt="" />On Dima’s Radar</a> turns “we should hang out” into actual invitations, while <a class="inline-project inline-project--dewey" href="https://dimadimadima.com/dewey" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">D</span>Dewey</a> makes spontaneous library stops feel less like a gamble</p>
    </article>

    <article class="now-card now-card--wide now-card--music">
      <span class="now-number">05</span>
      <span class="now-project-icon now-project-icon--music" aria-hidden="true">♪</span>
      <p class="section-kicker">Life, listening &amp; making</p>
      <div class="music-intro">
        <div>
          <h2>Family lore, now with a soundtrack</h2>
          <p>Two toddlers, an Atlanta summer, Mexico on the calendar, and an ongoing attempt to make family life feel expansive rather than merely efficient. <a class="inline-project inline-project--music" href="https://suno.com/@dimadimadimadima" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">♪</span>My Suno songs</a> are still my fastest route from an inside joke or family memory to something we all sing in the car</p>
        </div>
        <a href="https://suno.com/@dimadimadimadima" target="_blank" rel="noopener noreferrer">My Suno profile ↗</a>
      </div>
      <div class="song-grid" aria-label="Recent Suno songs">
        {SUNO_SONGS.map(song => (
          <a class="song-card" href={song.url} target="_blank" rel="noopener noreferrer">
            <span class="song-media">
              {song.video
                ? <video src={song.video} autoplay muted loop playsinline preload="metadata" aria-label={`Animated artwork for ${song.title}`} />
                : <img src={song.image} alt={`Artwork for ${song.title}`} loading="lazy" />}
              <span class="song-play" aria-hidden="true">▶</span>
            </span>
            <span class="song-copy"><strong>{song.title}</strong><small>{song.note}</small></span>
          </a>
        ))}
      </div>
    </article>
  </section>

  <aside class="now-note">
    <span>About this page</span>
    <p>A `/now` page is intentionally temporary. I update it when the center of gravity changes—not every time a task moves across a board.</p>
  </aside>
</Layout>

<style>
  .now-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding: clamp(4.5rem, 9vw, 7.5rem) 0 4rem;
    border-bottom: 1px solid var(--border);
  }
  .now-intro { max-width: 29rem; padding-bottom: .45rem; }
  .now-intro p { margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .now-intro span { display: block; margin-top: 1.2rem; color: var(--gold); font: 500 .68rem/1.4 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .now-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 3.5rem 0 1rem; }
  .now-card { position: relative; min-height: 19rem; padding: 2rem; border: 1px solid var(--border); border-radius: 18px; background: var(--surface); }
  .now-card--work { background: color-mix(in srgb, #0B5A58 9%, var(--surface)); }
  .now-card--build { background: color-mix(in srgb, var(--gold) 7%, var(--surface)); }
  .now-card--wide { grid-column: 1 / -1; min-height: 14rem; }
  .now-card--music { padding: clamp(1.5rem, 4vw, 2.25rem); }
  .now-number { position: absolute; top: 1.25rem; right: 1.35rem; color: var(--border-hi); font: 600 .78rem/1 'DM Mono', monospace; }
  .now-project-icon { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; margin-bottom: 1.25rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--gold); font: 650 1rem/1 'DM Sans', sans-serif; }
  .now-project-icon--groundline { background: #0B5A58; color: #FAF7EF; font-size: 1.35rem; }
  .now-project-icon--permit { color: #0B5A58; font-size: 1.35rem; }
  .now-project-icon--radar img { width: 1.75rem; height: 1.75rem; }
  .now-project-icon--music { background: #1b1328; color: #e8c667; }
  .now-card h2 { max-width: 27rem; margin: .7rem 0 .8rem; font-size: clamp(1.45rem, 3vw, 2.15rem); letter-spacing: -.045em; line-height: 1.05; }
  .now-card > p:not(.section-kicker) { max-width: 34rem; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .now-card > a, .now-links a { display: inline-block; margin-top: 1.3rem; color: var(--ink); font: 600 .68rem/1.4 'DM Mono', monospace; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .now-card a:hover { color: var(--gold); }
  .now-links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  .inline-project { display: inline-flex; align-items: center; gap: .3rem; margin: 0 .12rem; padding: .15rem .4rem; border: 1px solid var(--border); border-radius: 5px; background: var(--bg); color: var(--ink); font-weight: 600; line-height: 1.25; text-decoration: none; white-space: nowrap; }
  .inline-project:hover { border-color: color-mix(in srgb, var(--gold) 50%, var(--border)); color: var(--gold); }
  .inline-project img,
  .inline-project > span { display: grid; place-items: center; width: 1rem; height: 1rem; flex: 0 0 1rem; object-fit: contain; font: 700 .62rem/1 'DM Sans', sans-serif; }
  .inline-project--groundline > span { border-radius: 2px; background: #0B5A58; color: #fff; }
  .inline-project--permit > span { color: #0B5A58; font-size: .9rem; }
  .inline-project--dewey > span { border-radius: 50%; background: #314A36; color: #fff; }
  .inline-project--music > span { border-radius: 50%; background: #1b1328; color: #e8c667; }
  .music-intro { display: flex; justify-content: space-between; gap: 2rem; align-items: end; }
  .music-intro > div { max-width: 42rem; }
  .music-intro h2 { max-width: none; }
  .music-intro p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .music-intro > a { flex: 0 0 auto; color: var(--ink); font: 600 .68rem/1.4 'DM Mono', monospace; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .music-intro > a:hover { color: var(--gold); }
  .song-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin-top: 1.75rem; }
  .song-card { overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); color: inherit; text-decoration: none; transition: transform .2s, border-color .2s; }
  .song-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--gold) 48%, var(--border)); }
  .song-media { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 3; background: #111; }
  .song-media video,
  .song-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 28%; }
  .song-play { position: absolute; inset: 50% auto auto 50%; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: rgba(250,247,239,.92); color: #111; font-size: .65rem; transform: translate(-50%,-50%); }
  .song-copy { display: flex; min-width: 0; flex-direction: column; gap: .2rem; padding: .8rem; }
  .song-copy strong { overflow: hidden; color: var(--ink); font-size: .8rem; text-overflow: ellipsis; white-space: nowrap; }
  .song-copy small { color: var(--muted); font-size: .68rem; }
  .now-note { display: grid; grid-template-columns: 10rem 1fr; gap: 2rem; margin: 1rem 0 5rem; padding: 1.3rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .now-note span { color: var(--gold); font: 500 .68rem/1.5 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .now-note p { max-width: 44rem; margin: 0; color: var(--muted); font-size: .84rem; }
  @media (max-width: 760px) {
    .now-hero { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 4rem; }
    .now-grid { grid-template-columns: 1fr; margin-top: 2rem; }
    .now-card--wide { grid-column: auto; }
    .song-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .now-card { min-height: 0; padding: 1.4rem; }
    .now-note { grid-template-columns: 1fr; gap: .5rem; }
    .music-intro { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .song-grid { gap: .55rem; margin-top: 1.25rem; }
    .song-copy { padding: .65rem; }
    .song-copy small { display: none; }
  }
</style>
